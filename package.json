{
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "autofix:py": "uv run python",
    "autofix:ts": "npx @biomejs/biome check --unsafe --write ./ && npm run typecheck",
    "autofix": "npm run autofix:ts && npm run autofix:py",
    "lint": "npx @biomejs/biome check ./ --formatter-enabled=false",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "tailwindcss": "^4.1.17"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "flowbite": "^3.1.2"
  }
}
