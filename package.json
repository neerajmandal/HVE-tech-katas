{
  "scripts": {
    "autofix:py": "uv run ruff check --fix && uv run ruff format",
    "autofix:ts": "npx @biomejs/biome check --unsafe --write ./ && npm run typecheck",
    "autofix": "npm run autofix:ts && npm run autofix:py",
    "browser:codegen": "npx playwright codegen --browser chromium http://127.0.0.1:8000",
    "browser:open": "npx playwright open --browser chromium http://127.0.0.1:8000",
    "build:css": "npx @tailwindcss/cli -i static/input.css -o static/output.css --config tailwind.config.js",
    "build:static": "uv run python manage.py collectstatic --noinput",
    "build": "npm run build:css && npm run build:static",
    "dev": "uv run python manage.py runserver",
    "install:browser": "npx playwright install chromium",
    "install:browser:container": "npm run install:browser && npx playwright install-deps chromium",
    "lint": "npx @biomejs/biome check ./ --formatter-enabled=false",
    "setup": "node scripts/setup.mjs",
    "setup:devcontainer": "node scripts/setup.mjs --provision-browser",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "flowbite": "^4.0.2"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    }
  }
}
