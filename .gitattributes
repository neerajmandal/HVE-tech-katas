# Setting text=auto enables automatic crlf transformations and can cause issues
# with files sensitive to line endings or (rarely) corrupt binary data.

# Preferences for file type line endings are explicitly noted below.

* text=auto eol=lf

# Windows scripts - must be CRLF
*.ps text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Linux scripts - must be LF
*.sh text eol=lf
*.Dockerfile text eol=lf
Dockerfile text eol=lf

# User-generated code and text
*.py text eol=lf
*.ipynb text eol=lf
*.cs text eol=crlf

# Configuration and markup
.gitignore text eol=lf
.env text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf
